{
  "name": "cairn",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open-source iPhone lock screen wallpapers that show your time as a grid of dots.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cairn/web",
    "build": "npm run build -w @cairn/web",
    "preview": "npm run preview -w @cairn/web",
    "test": "npm run test -w @cairn/core",
    "typecheck": "npm run typecheck --workspaces"
  }
}
